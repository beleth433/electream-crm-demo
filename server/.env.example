PORT=4000
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ebike_crm?schema=public"
UPLOADS_DIR="./uploads"
NODE_ENV="development"

# Optional isolated local storage (paths are relative to the server process)
# CRM_DATA_DIR="./data"
# CRM_UPLOADS_DIR="./uploads"
# CRM_STORAGE_MODE="LOCAL_FILE"

# Optional stable session signing secret; otherwise stored in the CRM database
# SESSION_SECRET=""

# Cloud document storage (required for persistent uploads on Vercel)
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="crm-documents"
